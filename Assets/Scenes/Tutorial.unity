MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1915939932}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7d709134151d1734ea3873a2010c4a26, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialHint
  label: HOW TO GET PAST
  title: The red door is locked
  steps:
  - Walk up to the red door. Your front half is now over the blue glass.
  - Press [C] and cut straight down through your middle.
  - Keep the back half. The front half is blue like the glass, so it drops onto the
    <color=#FFD54A>gold plate</color> and opens the door.
  - Walk through the open door.
  stuckHint: Fell onto the plate yourself? Press [F] to switch to your other half.
    The door stays open while a piece of you sits on the gold plate.
  stuckDelay: 12
  size: {x: 12, y: 12, z: 8}
