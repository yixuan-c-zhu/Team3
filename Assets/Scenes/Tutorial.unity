  m_Script: {fileID: 11500000, guid: 7d709134151d1734ea3873a2010c4a26, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialHint
  label: HOW TO GET ACROSS
  title: The road ends at a gap
  steps:
  - Climb the hill and stand on the <color=#FFD54A>gold ledge</color> at the far
    end.
  - In 2D, press [C] and cut a thin, flat slice along the orange line at your feet.
    Keep the bigger piece.
  - Press [Tab] for 3D and step onto the white pad beside the path. Line the slice
    up with the gap and it becomes your bridge.
  - Your bridge is blue glass, and so are you. Press [Shift] to turn orange, then
    walk across.
  stuckHint: Fell through? Blue falls through blue glass. Climb the steps back up,
    press [Shift] to turn orange, and cross again.
  stuckDelay: 12
  size: {x: 38, y: 15, z: 8}
