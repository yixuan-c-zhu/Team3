  m_Script: {fileID: 11500000, guid: 7d709134151d1734ea3873a2010c4a26, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialHint
  label: HOW TO GET PAST
  title: This wall looks solid, but it isn't
  steps:
  - In 2D, press [Q] or [E] to look from the side. There's a narrow gap in the middle
    of the wall.
  - Press [C] and cut straight down, so the piece you keep is thinner than the gap.
  - Line up with the gap, press [Q] or [E] to turn back, and walk through.
  stuckHint: From the front, the wall hides the gap. Still in 3D? Press [Tab] for
    2D first, then turn to a side view. Still too wide? You have a spare cut.
  stuckDelay: 12
  size: {x: 6.5, y: 12, z: 8}
