  m_Script: {fileID: 11500000, guid: 3e7df5b688d15bf4aa5ba455df103d1c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CheckpointManager
  rooms:
  - title: "Tutorial \xB7 Cut to fit"
    tips: '<color=#FFD54A>C</color>  Cut

      <color=#FFD54A>Tab</color>  2D /
      3D

      <color=#FFD54A>Q E</color>  Turn the view

      <color=#FFD54A>WASD</color> 
      Move  <color=#FFD54A>Space</color>  Jump

      Goal: reach <color=#6CFF9A>CHECKPOINT</color>'
    cuts: 3
    spawn: {fileID: 1108765324}
    root: {fileID: 1565223702}
    exit: {fileID: 244929417}
    startIn2D: 0
  - title: "Tutorial \xB7 Leave a little behind"
    tips: 'Leave a piece on the

      <color=#FFD54A>gold plate</color> to open

      the
      <color=#FF6B6B>red door</color>

      <color=#5AAEFF>Blue</color> falls through

      <color=#5AAEFF>blue
      glass</color>

      <color=#FFD54A>F</color>  Switch piece'
    cuts: 2
    spawn: {fileID: 1439947253}
    root: {fileID: 1548872218}
    exit: {fileID: 437967654}
    startIn2D: 0
  - title: "Tutorial \xB7 First bridge"
    tips: 'Leave a thin slice on the

      <color=#FFD54A>gold ledge</color>, then
      aim

      from the white pad

      <color=#FFD54A>Tab</color>  3D   <color=#FFD54A>Shift</color> 
      Color'
    cuts: 2
    spawn: {fileID: 831992052}
    root: {fileID: 1798682369}
    exit: {fileID: 515520390}
    startIn2D: 0
  - title: "Tutorial \xB7 Building Bridge"
    tips: 'Find the teal path.

      Leave a slice on the

      <color=#FFD54A>gold
      ledge</color>.

      Build your bridge.'
    cuts: 1
    spawn: {fileID: 1224504892}
    root: {fileID: 746567393}
    exit: {fileID: 1848587968}
    startIn2D: 1
