  m_Script: {fileID: 11500000, guid: 7d709134151d1734ea3873a2010c4a26, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialHint
  label: HOW TO GET ACROSS
  title: The road ends at a pit
  steps:
  - Press [Tab] to switch to 3D and look around.
  - A teal path runs behind the pit. Teal things only show up in 3D.
  - Walk onto the teal path, follow it around the pit, and step back onto the road.
  stuckHint: The path starts just before the pit, on the far side of the road. Fell
    in? Climb the steps back up.
  stuckDelay: 12
  size: {x: 14.5, y: 12, z: 9}
