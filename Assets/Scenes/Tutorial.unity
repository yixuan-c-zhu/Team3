  m_Script: {fileID: 11500000, guid: 7d709134151d1734ea3873a2010c4a26, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialHint
  label: HOW TO GET PAST
  title: The ceiling is too low for you
  steps:
  - Press [C] to start a cut.
  - Drag a line straight across your body, lower than the bottom of the ceiling.
  - Click the lower piece to keep it, then walk underneath.
  stuckHint: Your cut has to be lower than the ceiling's bottom edge. Cut too high?
    You have spare cuts, so try again a little lower.
  stuckDelay: 12
  size: {x: 9.5, y: 12, z: 8}
