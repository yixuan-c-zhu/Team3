  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7d709134151d1734ea3873a2010c4a26, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialHint
  label: HOW TO GET ACROSS
  title: The road ends at a gap
  steps:
  - 'Press [Tab] for 3D and look around: a teal path climbs up behind the road, like
    the one in room 1.'
  - Follow it up to the lookout and stand on the <color=#FFD54A>gold ledge</color>.
  - In 2D, cut a thin slice along the orange line at your feet, like in room 3.
  - Aim from the white pad, then press [Shift] to turn orange and cross your bridge.
  stuckHint: The hidden path starts near the beginning of this room, on the far side
    of the road. It only shows up in 3D.
  stuckDelay: 12
  size: {x: 30, y: 24, z: 24}
