.menu-root {
    flex-grow: 1;
    background-color: rgb(214, 225, 222);
    color: rgb(34, 40, 58);
}
.scenery { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.block-hit { position: absolute; }
.cube { position: absolute; }

.ticket { position: absolute; left: 44px; top: 36px; width: 340px; height: 78px; }
.ticket-title {
    position: absolute; left: 30px; top: 0; bottom: 0; width: 220px;
    margin: 0; padding: 0;
    font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-left;
    color: rgb(34, 40, 58);
}
.ticket-count {
    position: absolute; right: 8px; top: 12px; width: 78px;
    margin: 0; padding: 0;
    font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center;
    color: rgb(34, 40, 58);
}
.ticket-caption {
    position: absolute; right: 8px; top: 42px; width: 78px;
    margin: 0; padding: 0;
    font-size: 13px; -unity-text-align: middle-center;
    color: rgb(90, 96, 112);
}

.paper-shadow {
    position: absolute; left: 6px; top: 6px; right: -6px; bottom: -6px;
    background-color: rgba(34, 40, 58, 0.22);
    border-radius: 7px;
}
.sign-wrap { position: absolute; }
.sign {
    flex-grow: 1;
    margin: 0; padding: 0 8px;
    background-color: rgb(247, 246, 241);
    border-width: 3px; border-color: rgb(34, 40, 58); border-radius: 6px;
    font-size: 23px; -unity-font-style: bold; -unity-text-align: middle-center;
    color: rgb(34, 40, 58);
    transition-property: translate, scale, border-color, background-color;
    transition-duration: 0.12s;
}
.sign:hover { translate: 0 -4px; background-color: rgb(255, 255, 252); }
.sign:active { translate: 0 1px; background-color: rgb(236, 234, 225); }
.sign.selected { border-color: rgb(47, 122, 85); border-width: 4px; scale: 1.07 1.07; }
.sign.locked { opacity: 0.45; }

.hint { position: absolute; left: 0; right: 0; bottom: 26px; align-items: center; }
.hint-wrap { position: relative; }
.hint-card {
    flex-direction: row; align-items: center;
    padding: 9px 18px;
    background-color: rgb(247, 246, 241);
    border-width: 3px; border-color: rgb(34, 40, 58); border-radius: 10px;
}
.keycap {
    min-width: 32px; height: 30px;
    margin: 0 6px 0 0; padding: 0 8px;
    background-color: rgb(255, 213, 74);
    border-width: 2px; border-color: rgb(34, 40, 58); border-radius: 6px;
    font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-center;
    color: rgb(34, 40, 58);
}
.hint-text { margin: 0 18px 0 2px; padding: 0; font-size: 17px; color: rgb(34, 40, 58); }
.hint-text.last { margin-right: 0; color: rgb(90, 96, 112); }

.error-message {
    position: absolute; left: 0; right: 0; bottom: 96px;
    font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center;
    color: rgb(164, 63, 47);
}
