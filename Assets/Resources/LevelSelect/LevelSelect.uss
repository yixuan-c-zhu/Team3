.menu-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(229, 234, 229);
    color: rgb(36, 53, 55);
    -unity-font-style: normal;
}
.menu-panel {
    width: 680px;
    max-width: 92%;
    height: 300px;
    padding: 42px 42px 32px;
    background-color: rgb(250, 250, 245);
    border-width: 1px;
    border-color: rgb(193, 205, 194);
    border-bottom-width: 4px;
    border-radius: 16px;
}
.panel-header { height: 48px; margin-bottom: 32px; justify-content: center; }
.panel-title {
    margin: 0;
    padding: 0;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
Button {
    margin: 0;
    padding: 0;
    color: rgb(36, 53, 55);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}
.button-row { flex-direction: row; height: 88px; margin-left: -7px; margin-right: -7px; }
.menu-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 7px;
    background-color: rgb(233, 239, 228);
    border-width: 1px;
    border-color: rgb(192, 207, 184);
    border-radius: 9px;
    font-size: 22px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}
.menu-button:hover { background-color: rgb(215, 228, 207); border-color: rgb(121, 150, 111); }
.menu-button:focus { border-width: 2px; border-color: rgb(93, 126, 83); }
.menu-button:active { background-color: rgb(193, 212, 181); }
.menu-button:disabled { opacity: 0.4; }
.number-button { font-size: 28px; }
.back-button {
    position: absolute;
    left: -4px;
    top: 2px;
    width: 44px;
    height: 44px;
    background-color: transparent;
    border-width: 0;
    border-radius: 7px;
    font-size: 27px;
}
.back-button:hover, .back-button:focus { background-color: rgb(233, 239, 228); }
.error-message { margin-top: 14px; font-size: 13px; color: rgb(164, 67, 48); -unity-text-align: middle-center; }
.compact .menu-panel { padding-left: 22px; padding-right: 22px; }
.compact .menu-button { font-size: 18px; margin-left: 4px; margin-right: 4px; }
.compact .number-button { font-size: 26px; }
